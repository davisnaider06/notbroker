# Porta HTTP/WebSocket da API.
PORT=3333

# Sem DATABASE_URL a API usa PGlite (Postgres embutido) em ./.data/pglite.
# Em produção, aponte para um Postgres de verdade (ex.: Neon free tier).
# DATABASE_URL=postgres://user:pass@host:5432/notbroker

# Segredo das sessões. Gere com: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
# URL pública por onde o navegador chega na API (em dev, o proxy do Vite).
BETTER_AUTH_URL=http://localhost:5173

# Opcional: chaves grátis da Alpaca (conta paper, sem depósito) liberam WebSocket
# real-time das ações dos EUA. Sem elas, EUA cai no polling do Yahoo.
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=

# Intervalo de polling do Yahoo (B3 e EUA sem Alpaca), em ms.
YAHOO_POLL_MS=15000
