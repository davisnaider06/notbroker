{
  "name": "b-hook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "check": "biome check .",
    "fix": "biome check --write .",
    "verify": "npm run check && npm run typecheck && npm run test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  }
}
